    <mxCell id="e11" edge="1" parent="1" source="threat" target="xauth" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;endArrow=block;endFill=1;dashed=1;" value="Risk signal enrichment">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <mxCell id="legend" value="C4 legend:   dark blue = person   ·   blue = system in scope   ·   grey = external system   ·   dashed = supporting/verification flow" style="text;whiteSpace=wrap;html=1;fontSize=10;fontStyle=2;fontColor=#666666;align=center;" vertex="1" parent="1">
