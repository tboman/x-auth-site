    <mxCell id="e9" edge="1" parent="1" source="xauth" target="idps" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;endArrow=block;endFill=1;" value="Federated login">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e10" edge="1" parent="1" source="xauth" target="kms" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;endArrow=block;endFill=1;dashed=1;" value="Signing keys (prod)">
