    <mxCell id="r5" edge="1" parent="boundary" source="oidc" target="clients" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;endArrow=block;endFill=1;" value="orchestration">
      <mxGeometry relative="1" as="geometry"/>
