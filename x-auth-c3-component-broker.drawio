<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <mxCell id="title" value="X-Auth — C3 Component Diagram: broker-service (C4 model)" style="text;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="340" y="10" width="760" height="30" as="geometry"/>
    </mxCell>

    <mxCell id="mcp_client" value="AI Agent Runtime (MCP client)&#xa;[Software System]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="580" y="60" width="280" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="boundary" value="broker-service  [Container boundary: Go 1.22 · :8182 · mcp.x-auth.com]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#438DD5;dashed=1;dashPattern=8 4;fontColor=#438DD5;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;container=1;collapsible=0;" vertex="1" parent="1">
      <mxGeometry x="60" y="160" width="1320" height="780" as="geometry"/>
    </mxCell>

    <mxCell id="router" value="HTTP Router&#xa;[Component: net/http + httpx]&#xa;&#xa;Recover + structured logging; public OIDC surface,&#xa;/.well-known discovery + jwks.json, tenant admin /v1 tree (tenantx)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontSize=11;" vertex="1" parent="boundary">
      <mxGeometry x="370" y="50" width="580" height="90" as="geometry"/>
    </mxCell>

    <mxCell id="oidc" value="OIDC Handlers&#xa;[Component: internal/oidc.go]&#xa;&#xa;/authorize (PKCE S256 required) · /token: code grant&#xa;(install orchestration) + refresh grant (rotation,&#xa;replay → install-family revocation) · /revoke (RFC 7009)&#xa;· /userinfo (hybrid: signature + stored-record deny-list)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontSize=11;" vertex="1" parent="boundary">
      <mxGeometry x="40" y="190" width="380" height="130" as="geometry"/>
    </mxCell>
    <mxCell id="dcr" value="DCR Registry&#xa;[Component: internal/dcr.go]&#xa;&#xa;RFC 7591 dynamic client registration&#xa;for MCP runtimes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontSize=11;" vertex="1" parent="boundary">
      <mxGeometry x="480" y="190" width="280" height="100" as="geometry"/>
    </mxCell>
    <mxCell id="install" value="Install Admin&#xa;[Component: internal/install.go]&#xa;&#xa;/v1/installs CRUD + keyset pagination;&#xa;revoke → grant cascade + identity release" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontSize=11;" vertex="1" parent="boundary">
      <mxGeometry x="820" y="190" width="300" height="100" as="geometry"/>
    </mxCell>

    <mxCell id="signer" value="JWT Signer / Verifier&#xa;[Component: pkg/jwtx]&#xa;&#xa;RS256 compact JWS; claims sub=identity subject,&#xa;aud=DCR client, extras install/persona/identity;&#xa;JWKS publishing; key from JWT_SIGNING_KEY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontSize=11;" vertex="1" parent="boundary">
      <mxGeometry x="40" y="390" width="330" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="clients" value="Downstream Clients&#xa;[Component: internal/clients.go]&#xa;&#xa;persona / pool / grant over /internal/v1;&#xa;tlsx mTLS transport + X-Internal-Auth;&#xa;request-context propagation; WithoutCancel&#xa;for compensation and revoke cascades" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontSize=11;" vertex="1" parent="boundary">
      <mxGeometry x="480" y="390" width="330" height="130" as="geometry"/>
    </mxCell>
    <mxCell id="storage" value="Storage&#xa;[Component: internal/storage.go interface]&#xa;&#xa;MemStorage (dev fallback)  |  PGStorage (pgxdb pool)&#xa;installs · dcr_clients · auth_codes · tokens&#xa;(rotated_at, refresh lookup) · keyset pagination" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontSize=11;" vertex="1" parent="boundary">
      <mxGeometry x="900" y="390" width="350" height="120" as="geometry"/>
    </mxCell>
    <mxCell id="sweeper" value="Purge Sweeper&#xa;[Component: cmd/main.go goroutine]&#xa;&#xa;PURGE_INTERVAL ticker; deletes expired&#xa;tokens + auth codes; signal-aware shutdown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontSize=11;" vertex="1" parent="boundary">
      <mxGeometry x="900" y="580" width="350" height="100" as="geometry"/>
    </mxCell>

    <mxCell id="flow_note" value="Code-grant orchestration: consume one-shot auth code → verify PKCE → pending install → GetPersona (scopes, TTL) → ClaimIdentity → sign JWT + mint refresh → CreateGrant (hashes only) → install active.&#xa;Compensation on failure: release claimed identity, mark install revoked. Refresh replay: revoke install, cascade grants, release identity, delete token records." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;verticalAlign=middle;dashed=1;dashPattern=8 4;" vertex="1" parent="boundary">
      <mxGeometry x="40" y="580" width="770" height="100" as="geometry"/>
    </mxCell>

    <mxCell id="r1" edge="1" parent="boundary" source="router" target="oidc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;endArrow=block;endFill=1;" value="routes">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
