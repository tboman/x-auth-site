    </mxCell>
    <mxCell id="r3" edge="1" parent="boundary" source="router" target="install" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;endArrow=block;endFill=1;" value="/v1/installs">
