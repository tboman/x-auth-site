    <mxCell id="r6" edge="1" parent="boundary" source="oidc" target="storage" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="codes · tokens · installs">
      <mxGeometry relative="1" as="geometry"/>
