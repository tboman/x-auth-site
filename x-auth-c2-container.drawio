<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <mxCell id="title" value="X-Auth — C2 Container Diagram (C4 model)" style="text;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="400" y="10" width="720" height="30" as="geometry"/>
    </mxCell>

    <mxCell id="customer_app" value="Customer Application&#xa;[Software System]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="240" y="70" width="200" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="agent_runtime" value="AI Agent Runtime (MCP client)&#xa;[Software System]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1060" y="70" width="220" height="60" as="geometry"/>
    </mxCell>

    <mxCell id="boundary" value="X-Auth Platform  [System boundary]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1168BD;dashed=1;dashPattern=8 4;fontColor=#1168BD;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;container=1;collapsible=0;" vertex="1" parent="1">
      <mxGeometry x="60" y="180" width="1460" height="930" as="geometry"/>
    </mxCell>

    <mxCell id="gateway" value="API Gateway&#xa;[Container: LB / ingress]&#xa;TLS 1.3 termination, routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=11;" vertex="1" parent="boundary">
      <mxGeometry x="430" y="40" width="600" height="60" as="geometry"/>
    </mxCell>

    <mxCell id="txn" value="transaction-service&#xa;[Container: Go 1.22 · :8080 · Public]&#xa;&#xa;/v1/advice risk evaluation entry point,&#xa;transaction authorization, step-up orchestration,&#xa;per-tenant rate limiting (ratex)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=11;" vertex="1" parent="boundary">
      <mxGeometry x="80" y="140" width="310" height="120" as="geometry"/>
    </mxCell>
    <mxCell id="authn" value="authentication-service&#xa;[Container: Go 1.22 · :8082 · Public]&#xa;&#xa;OIDC provider: RS256 JWT access + ID tokens,&#xa;JWKS, PKCE S256, refresh rotation with&#xa;family revocation, sessions, users" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=11;" vertex="1" parent="boundary">
      <mxGeometry x="80" y="320" width="310" height="120" as="geometry"/>
    </mxCell>
    <mxCell id="risk" value="risk-service&#xa;[Container: Go 1.22 · :8081 · Internal]&#xa;&#xa;Weighted scorers (device/behavior/network/user),&#xa;policy engine, tier assignment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=11;" vertex="1" parent="boundary">
      <mxGeometry x="80" y="500" width="310" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="authr" value="authenticator-service&#xa;[Container: Go 1.22 · :8083 · Internal]&#xa;&#xa;Challenge dispatch/verify, vendor adapters,&#xa;attempt caps, backoff, account lockout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=11;" vertex="1" parent="boundary">
      <mxGeometry x="80" y="670" width="310" height="110" as="geometry"/>
    </mxCell>

    <mxCell id="broker" value="broker-service&#xa;[Container: Go 1.22 · :8182 · Public]&#xa;&#xa;MCP identity broker: DCR, PKCE S256 code grant,&#xa;refresh grant with install-family revocation,&#xa;JWT issuance + JWKS, install lifecycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=11;" vertex="1" parent="boundary">
      <mxGeometry x="1080" y="140" width="310" height="120" as="geometry"/>
    </mxCell>
    <mxCell id="persona" value="persona-service&#xa;[Container: Go 1.22 · :8180 · Internal]&#xa;&#xa;Persona definitions: scopes, claims, token TTL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=11;" vertex="1" parent="boundary">
      <mxGeometry x="1080" y="320" width="310" height="100" as="geometry"/>
    </mxCell>
    <mxCell id="pool" value="pool-service&#xa;[Container: Go 1.22 · :8181 · Internal]&#xa;&#xa;Identity pools: claim (oldest-first, row-locked),&#xa;release, revoke" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=11;" vertex="1" parent="boundary">
      <mxGeometry x="1080" y="480" width="310" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="grant" value="grant-service&#xa;[Container: Go 1.22 · :8183 · Internal]&#xa;&#xa;Grant records (token hashes only), RFC 7662&#xa;introspection, RFC 7009 revoke, append-only audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=11;" vertex="1" parent="boundary">
      <mxGeometry x="1080" y="650" width="310" height="110" as="geometry"/>
    </mxCell>

    <mxCell id="mtls" value="Service-to-service: mTLS (tlsx) + /internal/v1/ trees behind InternalAuth (verified peer cert or X-Internal-Auth shared secret)" style="text;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fontColor=#B85450;align=center;" vertex="1" parent="boundary">
      <mxGeometry x="430" y="820" width="600" height="30" as="geometry"/>
    </mxCell>

    <mxCell id="pg_apps" value="Apps databases&#xa;[Container: PostgreSQL 16]&#xa;txn_db · risk_db · authn_db · authenticator_db&#xa;one DB per service, golang-migrate migrations" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=10;size=12;" vertex="1" parent="boundary">
      <mxGeometry x="490" y="500" width="230" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="pg_agents" value="Agents databases&#xa;[Container: PostgreSQL 16]&#xa;persona_db · pool_db · broker_db · grant_db&#xa;one DB per service, golang-migrate migrations" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=10;size=12;" vertex="1" parent="boundary">
      <mxGeometry x="760" y="500" width="230" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="redis" value="Shared Redis&#xa;[Container: Redis 7]&#xa;rate:* counters — cross-replica rate limits&#xa;and lockout counting; fail-open" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=10;size=12;" vertex="1" parent="boundary">
      <mxGeometry x="625" y="670" width="230" height="110" as="geometry"/>
    </mxCell>

    <mxCell id="shared_pkg" value="Shared libraries (pkg/): logx · httpx (RunTLS, InternalAuth, ratex middleware) · config · tenantx · pgxdb · redisx · jwtx (RS256+JWKS) · tlsx · ratex" style="text;whiteSpace=wrap;html=1;fontSize=10;fontStyle=2;fontColor=#666666;align=center;" vertex="1" parent="boundary">
