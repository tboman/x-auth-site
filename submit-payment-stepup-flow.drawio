        <mxCell id="a4" value="risk-service&#10;(/v1/assurance)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="630" y="50" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="authentication-service&#10;(OIDC OP)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="830" y="50" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="authenticator-service&#10;(WebAuthn / push)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1030" y="50" width="140" height="50" as="geometry" />
