        <mxCell id="a3" value="transaction-service&#10;(/v1/advice)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="430" y="50" width="140" height="50" as="geometry" />
