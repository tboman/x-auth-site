    <mxCell id="authn_detail" value="OIDC Provider  Sessions&#xa;Tokens  Social Login  SAML" style="text;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=top;fontColor=#666666;" vertex="1" parent="platform">
