      <mxGeometry x="40" y="340" width="220" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="risk_detail" value="Signal Ingestion  Risk Scoring&#xa;Policy Engine  Continuous Eval" style="text;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=top;fontColor=#666666;" vertex="1" parent="platform">
      <mxGeometry x="50" y="410" width="200" height="40" as="geometry"/>
