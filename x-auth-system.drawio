    </mxCell>
    <mxCell id="pipeline" value="Risk Signal Pipeline:   Device ×0.25  ·  Behavior ×0.30  ·  Network ×0.25  ·  User ×0.20   →   weighted aggregation + policy overlay + resource sensitivity   →   tier LOW / MED / HIGH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;dashed=1;dashPattern=8 4;verticalAlign=middle;" vertex="1" parent="apps">
      <mxGeometry x="30" y="440" width="630" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="apps_flow" value="advice flow: client → /v1/advice → risk evaluation → allow / step-up challenge / deny → session upgrade after verify" style="text;whiteSpace=wrap;html=1;fontSize=10;fontStyle=2;fontColor=#666666;align=center;" vertex="1" parent="apps">
      <mxGeometry x="30" y="505" width="630" height="30" as="geometry"/>
    </mxCell>

