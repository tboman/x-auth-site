    </mxCell>
    <mxCell id="install_note" value="Install lifecycle:   code grant → pending install → persona fetch → identity claim → JWT + grant recorded → active.   Install = token family: refresh replay revokes the install (grants cascade, identity released)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;dashed=1;dashPattern=8 4;verticalAlign=middle;" vertex="1" parent="agents">
      <mxGeometry x="30" y="440" width="630" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="agents_flow" value="persona selected at install time, not runtime · agent identity comes from the pool, never the human's" style="text;whiteSpace=wrap;html=1;fontSize=10;fontStyle=2;fontColor=#666666;align=center;" vertex="1" parent="agents">
      <mxGeometry x="30" y="505" width="630" height="30" as="geometry"/>
    </mxCell>

    <mxCell id="mtls_note" value="Service-to-service:  mTLS (tlsx, verified client certs)  +  /internal/v1/ trees guarded by InternalAuth (peer cert or X-Internal-Auth secret)" style="text;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fontColor=#b85450;align=center;" vertex="1" parent="platform">
