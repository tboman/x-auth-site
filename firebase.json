{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/fido",
        "destination": "/fido/index.html"
      },
      {
        "source": "/fido/**",
        "destination": "/fido/index.html"
      },
      {
        "source": "/id",
        "destination": "/id/index.html"
      },
      {
        "source": "/id/**",
        "destination": "/id/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
